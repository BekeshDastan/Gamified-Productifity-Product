# Only local development. Never use these values in production.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
AUTH_SIGNING_KEY=
AUTH_INSECURE_LOCAL_COOKIES=true
AUTH_LOGIN_FAILURES=5
AUTH_IP_FAILURES=50
AUTH_REGISTRATIONS=10
AUTH_USER_REQUESTS=120
AUTH_MAIL_REQUESTS=3
AUTH_TOKEN_ATTEMPTS=30
API_PORT=8080
API_HOST=127.0.0.1
DATABASE_URL=postgres://ascend:ascend_local_development_only@127.0.0.1:15432/ascend_dev?sslmode=disable
POSTGRES_PASSWORD=ascend_local_development_only
LOG_LEVEL=info

# Adapters are introduced in C015. External providers are disabled by default.
MAIL_DRIVER=local
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
MAIL_FROM=ascend@example.test
BLOB_DRIVER=local
BLOB_PRIVATE_DIR=.data/blobs
UPLOAD_SCAN_MODE=unavailable
# For a local clamd with current signatures: UPLOAD_SCAN_MODE=clamav.
# Keep clamd private; StreamMaxLength must be at least 10 MB.
CLAMAV_ADDRESS=127.0.0.1:3310
TEST_DATABASE_URL=postgres://ascend:ascend_local_development_only@127.0.0.1:15432/ascend_test?sslmode=disable
TEST_SMTP_ADDR=127.0.0.1:11025
TEST_MAIL_HTTP=http://127.0.0.1:18025
FEATURE_SOCIAL=false
FEATURE_GOOGLE_CALENDAR=false
FEATURE_GITHUB=false
FEATURE_MYSTERY_REWARDS=true
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Optional private metrics listener; a random token of at least 43 characters enables it.
OPS_ADDRESS=127.0.0.1:9090
OPS_BEARER_TOKEN=
# Trust forwarded client IP only from an explicitly configured reverse proxy.
TRUSTED_PROXY_CIDRS=
