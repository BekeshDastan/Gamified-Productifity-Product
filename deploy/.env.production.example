APP_ENV=production
APP_DOMAIN=ascend.example.com
APP_ORIGIN=https://ascend.example.com
RELEASE_TAG=reviewed-commit-sha
RELEASE_ENV_FILE=/srv/ascend/.env.production
POSTGRES_PASSWORD=
DATABASE_URL=postgres://ascend:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/ascend?sslmode=disable
AUTH_SIGNING_KEY=
AUTH_INSECURE_LOCAL_COOKIES=false
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
LOG_LEVEL=info
FEATURE_MYSTERY_REWARDS=true
# Optional; without both keys browser push is visibly unavailable.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Monitoring overlay reads the same token from a separate private file.
OPS_BEARER_TOKEN=
METRICS_TOKEN_FILE=/srv/ascend/secrets/metrics-token
# Contains RESTIC_REPOSITORY, RESTIC_PASSWORD and credentials for off-site storage.
BACKUP_ENV_FILE=/srv/ascend/secrets/backup.env
