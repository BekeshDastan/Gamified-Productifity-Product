{
  "name": "ascend",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev:web": "npm run dev --workspace @ascend/web",
    "build:web": "npm run build --workspace @ascend/web",
    "typecheck": "npm run typecheck --workspace @ascend/web",
    "generate:api": "openapi-typescript contracts/openapi.yaml -o apps/web/src/lib/api/schema.d.ts",
    "lint:web": "npm run lint --workspace @ascend/web",
    "lint:go": "node scripts/go-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:repo": "node scripts/check-repository.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:web": "npm run test --workspace @ascend/web",
    "dev": "node scripts/tasks.mjs dev",
    "lint": "node scripts/tasks.mjs lint",
    "test": "node scripts/tasks.mjs test",
    "check-changed": "node scripts/tasks.mjs check-changed",
    "build": "node scripts/tasks.mjs build",
    "migrate": "node scripts/tasks.mjs migrate",
    "seed": "node scripts/tasks.mjs seed",
    "test:integration": "node scripts/tasks.mjs test-integration",
    "test:e2e": "node scripts/tasks.mjs test-e2e"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10"
  }
}
